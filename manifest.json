{
  "manifest_version": 3,
  "name": "InfraHub TV Monitor",
  "version": "1.0.1",
  "description": "Heartbeat e recebimento de comandos para as TVs do InfraHub.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://infrahub-monitor-api.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
