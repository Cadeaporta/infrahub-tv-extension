{
  "manifest_version": 3,
  "name": "InfraHub TV Monitor",
  "version": "1.0.8",
  "description": "Monitoramento de TVs, comandos remotos e diagnóstico local do InfraHub.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://infrahub-monitor-api.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
